# ============================================
# DE RUTA - Environment Variables
# ============================================

# Node environment: development | production
NODE_ENV=development

# ============================================
# API
# ============================================
API_PORT=3000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Verification codes (minutes)
VERIFICATION_CODE_EXPIRATION_MINUTES=30

# ============================================
# Database
# ============================================
# In development with docker-compose, use postgres service
DB_HOST=localhost
DB_PORT=5432
DB_USER=deruta
DB_PASSWORD=deruta
DB_NAME=deruta

# In development without Docker, SQLite is used automatically
# DB_NAME=deruta

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:4200

# ============================================
# Email (SendGrid / Resend)
# ============================================
# Provider: sendgrid | resend | console (dev)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@deruta.app

# SendGrid
SENDGRID_API_KEY=

# Resend
RESEND_API_KEY=

# ============================================
# SMS (Twilio)
# ============================================
# Provider: twilio | console (dev)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# File Storage (Cloudinary / AWS S3)
# ============================================
# Provider: cloudinary | s3 | local (dev)
STORAGE_PROVIDER=local

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Local storage URL prefix
LOCAL_STORAGE_URL=http://localhost:3000/uploads
